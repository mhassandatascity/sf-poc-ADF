{
	"name": "PL_Clearwave",
	"properties": {
		"activities": [
			{
				"name": "Clearwave sftp to blob sync",
				"description": "Execute \"sftp-to-blob-sync.sh\" on the vm using runCommand",
				"type": "WebActivity",
				"dependsOn": [],
				"policy": {
					"timeout": "0.2:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"url": {
						"value": "https://management.azure.com/subscriptions/be059275-c554-4960-aa2f-74c2d286f11e/resourceGroups/@{pipeline().globalParameters.ENV_AZ_RG}/providers/Microsoft.Compute/virtualMachines/@{pipeline().globalParameters.ENV_AZ_DBT_VM}/runCommand?api-version=2023-09-01",
						"type": "Expression"
					},
					"body": {
						"value": "{\n  \"commandId\": \"RunShellScript\",\n  \"script\": [\n    \"su - appusr -c '/app/data/clearwave/sftp-to-blob-sync.sh @{pipeline().RunId}'\"\n  ]\n}\n",
						"type": "Expression"
					},
					"authentication": {
						"type": "MSI",
						"resource": "https://management.core.windows.net"
					}
				}
			},
			{
				"name": "checkExitStatus",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "getExitStatus",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@contains(\n    replace(\n      replace(variables('Script-ExitStatus'), '\\r\\n', ''),\n    '\\n', ''), \n    'SYNC_STATUS: PASSED'\n)\n",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Fail1",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": "Failed",
								"errorCode": "5"
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "onSuccess",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_Clearwave_snf_copy",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"SourceFolders": {
										"value": "@variables('SourceFolders')",
										"type": "Expression"
									}
								}
							}
						}
					]
				},
				"ifTrueActivities": [
					{
						"name": "SuccessActivity",
						"type": "SetVariable",
						"typeProperties": {
							"variableName": "SuccessMessage",
							"value": "Execution succeeded"
						}
					}
				],
				"ifFalseActivities": [
					{
						"name": "FailureActivity",
						"type": "SetVariable",
						"typeProperties": {
							"variableName": "FailureMessage",
							"value": "Execution failed"
						}
					}
				]
			},
			{
				"name": "getExitStatus",
				"description": "Get the status of the dbt run script",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Clearwave sftp to blob sync",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "Script-ExitStatus",
					"value": {
						"value": "@string(activity('Clearwave sftp to blob sync').output.value[0].message)\n",
						"type": "Expression"
					}
				}
			}
		],
		"variables": {
			"Script-ExitStatus": {
				"type": "String"
			},
			"SourceFolders": {
				"type": "Array",
				"defaultValue": [
					"middle",
					"oam",
					"onsmd",
					"orthoadc",
					"orthopedicsri",
					"osa",
					"smn"
				]
			}
		},
		"folder": {
			"name": "Job_Clearwave"
		},
		"annotations": []
	}
}