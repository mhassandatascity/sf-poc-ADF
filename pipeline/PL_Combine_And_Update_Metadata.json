{
	"name": "PL_Combine_And_Update_Metadata",
	"properties": {
		"activities": [
			{
				"name": "For Each Row Count Table To Process",
				"type": "ForEach",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@pipeline().parameters.row_count_tables",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Check Individual Row Count Files Exist",
							"type": "GetMetadata",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [
								{
									"name": "item",
									"value": "@{item()}"
								}
							],
							"typeProperties": {
								"dataset": {
									"referenceName": "DS_AzureBlob_Spire_Multifile_Binary",
									"type": "DatasetReference",
									"parameters": {
										"auth_sas_url_sec": {
											"value": "@pipeline().globalParameters.ENV_KV_SPIRE_AZURE_BLOB_SAS_URL_SEC",
											"type": "Expression"
										},
										"container": {
											"value": "@pipeline().parameters.tgt_container",
											"type": "Expression"
										},
										"path": {
											"value": "@{pipeline().parameters.tgt_metadata_output_path}/@{item()}/",
											"type": "Expression"
										}
									}
								},
								"fieldList": [
									"exists"
								],
								"storeSettings": {
									"type": "AzureBlobStorageReadSettings",
									"recursive": true,
									"enablePartitionDiscovery": false
								},
								"formatSettings": {
									"type": "BinaryReadSettings"
								}
							}
						},
						{
							"name": "If Individual Row Count Files Exist",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "Check Individual Row Count Files Exist",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [
								{
									"name": "item",
									"value": "@{item()}"
								}
							],
							"typeProperties": {
								"expression": {
									"value": "@activity('Check Individual Row Count Files Exist').output.exists",
									"type": "Expression"
								},
								"ifTrueActivities": [
									{
										"name": "Combine Row Count Files",
										"type": "Copy",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [
											{
												"name": "item",
												"value": "@{item()}"
											}
										],
										"typeProperties": {
											"source": {
												"type": "DelimitedTextSource",
												"storeSettings": {
													"type": "AzureBlobStorageReadSettings",
													"recursive": true,
													"wildcardFolderPath": {
														"value": "@{pipeline().parameters.tgt_metadata_output_path}/@{item()}",
														"type": "Expression"
													},
													"wildcardFileName": "*.csv",
													"enablePartitionDiscovery": false
												},
												"formatSettings": {
													"type": "DelimitedTextReadSettings"
												}
											},
											"sink": {
												"type": "DelimitedTextSink",
												"storeSettings": {
													"type": "AzureBlobStorageWriteSettings",
													"copyBehavior": "MergeFiles"
												},
												"formatSettings": {
													"type": "DelimitedTextWriteSettings",
													"quoteAllText": true,
													"fileExtension": ".txt"
												}
											},
											"enableStaging": false,
											"translator": {
												"type": "TabularTranslator",
												"typeConversion": true,
												"typeConversionSettings": {
													"allowDataTruncation": true,
													"treatBooleanAsNumber": false
												}
											}
										},
										"inputs": [
											{
												"referenceName": "DS_AzureBlob_Spire_MultiFile_CSV",
												"type": "DatasetReference",
												"parameters": {
													"auth_sas_url_sec": {
														"value": "@pipeline().globalParameters.ENV_KV_SPIRE_AZURE_BLOB_SAS_URL_SEC",
														"type": "Expression"
													},
													"path": {
														"value": "@pipeline().parameters.tgt_metadata_output_path",
														"type": "Expression"
													},
													"container": {
														"value": "@pipeline().parameters.tgt_container",
														"type": "Expression"
													}
												}
											}
										],
										"outputs": [
											{
												"referenceName": "DS_AzureBlob_Spire_SingleFile_CSV",
												"type": "DatasetReference",
												"parameters": {
													"auth_sas_url_sec": {
														"value": "@pipeline().globalParameters.ENV_KV_SPIRE_AZURE_BLOB_SAS_URL_SEC",
														"type": "Expression"
													},
													"path": {
														"value": "@{pipeline().parameters.tgt_metadata_output_path}",
														"type": "Expression"
													},
													"file": {
														"value": "@{item()}.csv",
														"type": "Expression"
													},
													"container": {
														"value": "@pipeline().parameters.tgt_container",
														"type": "Expression"
													}
												}
											}
										]
									},
									{
										"name": "Delete Row Count Files",
										"type": "Delete",
										"dependsOn": [
											{
												"activity": "Combine Row Count Files",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [
											{
												"name": "item",
												"value": "@{item()}"
											}
										],
										"typeProperties": {
											"dataset": {
												"referenceName": "DS_AzureBlob_Spire_Singlefile_Binary",
												"type": "DatasetReference",
												"parameters": {
													"auth_sas_url_sec": {
														"value": "@pipeline().globalParameters.ENV_KV_SPIRE_AZURE_BLOB_SAS_URL_SEC",
														"type": "Expression"
													},
													"container": {
														"value": "@pipeline().parameters.tgt_container",
														"type": "Expression"
													},
													"path": {
														"value": "@{pipeline().parameters.tgt_metadata_output_path}/@{item()}",
														"type": "Expression"
													},
													"file": {
														"value": "*",
														"type": "Expression"
													}
												}
											},
											"enableLogging": false,
											"storeSettings": {
												"type": "AzureBlobStorageReadSettings",
												"recursive": true,
												"wildcardFileName": "*",
												"enablePartitionDiscovery": false
											}
										}
									}
								]
							}
						}
					]
				}
			}
		],
		"parameters": {
			"tgt_container": {
				"type": "string"
			},
			"tgt_metadata_output_path": {
				"type": "string"
			},
			"tgt_db": {
				"type": "string"
			},
			"tgt_schema": {
				"type": "string"
			},
			"tgt_metadata_schema": {
				"type": "string"
			},
			"row_count_tables": {
				"type": "array"
			}
		},
		"folder": {
			"name": "Shared_Pipelines"
		},
		"annotations": []
	}
}