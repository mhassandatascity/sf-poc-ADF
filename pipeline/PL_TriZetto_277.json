{
	"name": "PL_TriZetto_277",
	"properties": {
		"activities": [
			{
				"name": "Execute PL_Output_Paths",
				"type": "ExecutePipeline",
				"dependsOn": [],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_Output_Paths",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"main_pipeline_name": {
							"value": "@pipeline().Pipeline",
							"type": "Expression"
						},
						"tgt_db": "X12_277",
						"tgt_schema": ""
					}
				}
			},
			{
				"name": "List 4L81 SFTP Files",
				"type": "GetMetadata",
				"dependsOn": [
					{
						"activity": "Execute PL_Output_Paths",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_TriZetto_4L81_SFTP_Folder",
						"type": "DatasetReference",
						"parameters": {
							"remote_directory": {
								"value": "@variables('src_folder')",
								"type": "Expression"
							}
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "SftpReadSettings",
						"recursive": false,
						"enablePartitionDiscovery": false,
						"disableChunking": false
					},
					"formatSettings": {
						"type": "BinaryReadSettings"
					}
				}
			},
			{
				"name": "Filter 4L81 Files",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "List 4L81 SFTP Files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('List 4L81 SFTP Files').output.childItems",
						"type": "Expression"
					},
					"condition": {
						"value": "@and(\n  equals(item().type, 'File'),\n  greaterOrEquals(\n    split(item().name, '.')[1],\n    formatDateTime(addDays(utcnow(), mul(-1, pipeline().parameters.lookback_days)), 'yyyyMMdd')\n  )\n)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Copy 4L81 Files To Blob",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Filter 4L81 Files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Filter 4L81 Files').output.value",
						"type": "Expression"
					},
