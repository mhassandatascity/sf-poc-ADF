											"variableName": "files_ingested_5l9m",
											"value": {
												"value": "@item().name",
												"type": "Expression"
											}
										}
									}
								]
							}
						}
					]
				}
			},
			{
				"name": "If Any New Files",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Copy 4L81 Files To Blob",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Copy 5L9M Files To Blob",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@greater(add(length(variables('files_ingested_4l81')), length(variables('files_ingested_5l9m'))), 0)",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Set Command",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "command",
								"value": {
									"value": "/bin/bash -c \" \\\nln -s /datadisk $(pwd)/datadisk && \\\npython3 x12_277_convert.py \\\n    --keyvault_url=@{pipeline().globalParameters.ENV_KV_BASE_URL}/ \\\n    --sec_edifabric_serial_name=@{variables('sec_edifabric_serial')} \\\n    --sec_edifabric_token_name=@{variables('sec_edifabric_token')} \\\n    --blob_url=@{pipeline().globalParameters.ENV_AZURE_BLOB_ACCOUNT_URL}/ \\\n    --blob_container=@{variables('tgt_container')} \\\n    --blob_input_path=@{activity('Execute PL_Output_Paths').output.pipelineReturnValue.bin_output_path} \\\n    --blob_output_path=@{activity('Execute PL_Output_Paths').output.pipelineReturnValue.data_output_path}\"",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Execute PL_Batch_Execute_Scripts",
							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "Set Command",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_Batch_Execute_Scripts",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"python_script_path": {
										"value": "@variables('convert_script_path')",
										"type": "Expression"
									},
									"command": {
										"value": "@variables('command')",
										"type": "Expression"
									},
									"main_pipeline_name": {
										"value": "@pipeline().Pipeline",
										"type": "Expression"
									},
									"main_pipeline_run_id": {
										"value": "@pipeline().RunId",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "Load Data Into Snowflake",
							"type": "Script",
							"dependsOn": [
								{
									"activity": "Execute PL_Batch_Execute_Scripts",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "LS_Snowflake_Spire",
								"type": "LinkedServiceReference",
								"parameters": {
									"warehouse": {
										"value": "@concat(toUpper(pipeline().globalParameters.ENV_STAGE), '_ADF_INGESTION_WH')",
										"type": "Expression"
									},
									"database": {
										"value": "@concat(toUpper(pipeline().globalParameters.ENV_STAGE), '_RAW')",
										"type": "Expression"
									},
									"user_name": {
										"value": "@concat(toUpper(pipeline().globalParameters.ENV_STAGE), '_SVC_ADF')",
										"type": "Expression"
									},
									"role": {
										"value": "@concat(toUpper(pipeline().globalParameters.ENV_STAGE), '_SVC_INGESTION_ROLE')",
										"type": "Expression"
									},
									"account_name": "spireortho-aaas.privatelink"
								}
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "NonQuery",
										"text": {
											"value": "@concat(\n  'COPY INTO ',toUpper(pipeline().globalParameters.ENV_STAGE),'_RAW.',variables('snowflake_schema'),'.X12_277_Interchanges FROM @',toUpper(pipeline().globalParameters.ENV_STAGE),'_RAW.',variables('snowflake_schema'),'.TRIZETTO_277/',activity('Execute PL_Output_Paths').output.pipelineReturnValue.data_folder_path,'X12_277_Interchanges.ndjson FILE_FORMAT = (TYPE = JSON) ON_ERROR = ''ABORT_STATEMENT'' MATCH_BY_COLUMN_NAME = CASE_INSENSITIVE;'\n)",
											"type": "Expression"
										}
									},
									{
										"type": "NonQuery",
										"text": {
											"value": "@concat(\n  'COPY INTO ',toUpper(pipeline().globalParameters.ENV_STAGE),'_RAW.',variables('snowflake_schema'),'.X12_277_Groups FROM @',toUpper(pipeline().globalParameters.ENV_STAGE),'_RAW.',variables('snowflake_schema'),'.TRIZETTO_277/',activity('Execute PL_Output_Paths').output.pipelineReturnValue.data_folder_path,'X12_277_Groups.ndjson FILE_FORMAT = (TYPE = JSON) ON_ERROR = ''ABORT_STATEMENT'' MATCH_BY_COLUMN_NAME = CASE_INSENSITIVE;'\n)",
											"type": "Expression"
										}
									},
									{
										"type": "NonQuery",
										"text": {
											"value": "@concat(\n  'COPY INTO ',toUpper(pipeline().globalParameters.ENV_STAGE),'_RAW.',variables('snowflake_schema'),'.X12_277_Transactions FROM @',toUpper(pipeline().globalParameters.ENV_STAGE),'_RAW.',variables('snowflake_schema'),'.TRIZETTO_277/',activity('Execute PL_Output_Paths').output.pipelineReturnValue.data_folder_path,'X12_277_Transactions.ndjson FILE_FORMAT = (TYPE = JSON) ON_ERROR = ''ABORT_STATEMENT'' MATCH_BY_COLUMN_NAME = CASE_INSENSITIVE;'\n)",
											"type": "Expression"
										}
									},
									{
										"type": "NonQuery",
										"text": {
											"value": "@concat(\n  'COPY INTO ',toUpper(pipeline().globalParameters.ENV_STAGE),'_RAW.',variables('snowflake_schema'),'.X12_277_Receiver_Statuses FROM @',toUpper(pipeline().globalParameters.ENV_STAGE),'_RAW.',variables('snowflake_schema'),'.TRIZETTO_277/',activity('Execute PL_Output_Paths').output.pipelineReturnValue.data_folder_path,'X12_277_Receiver_Statuses.ndjson FILE_FORMAT = (TYPE = JSON) ON_ERROR = ''ABORT_STATEMENT'' MATCH_BY_COLUMN_NAME = CASE_INSENSITIVE;'\n)",
											"type": "Expression"
										}
									},
									{
										"type": "NonQuery",
										"text": {
											"value": "@concat(\n  'COPY INTO ',toUpper(pipeline().globalParameters.ENV_STAGE),'_RAW.',variables('snowflake_schema'),'.X12_277_Billing_Providers FROM @',toUpper(pipeline().globalParameters.ENV_STAGE),'_RAW.',variables('snowflake_schema'),'.TRIZETTO_277/',activity('Execute PL_Output_Paths').output.pipelineReturnValue.data_folder_path,'X12_277_Billing_Providers.ndjson FILE_FORMAT = (TYPE = JSON) ON_ERROR = ''ABORT_STATEMENT'' MATCH_BY_COLUMN_NAME = CASE_INSENSITIVE;'\n)",
											"type": "Expression"
										}
									},
									{
