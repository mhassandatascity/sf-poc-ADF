						"value": "@activity('List 5L9M SFTP Files').output.childItems",
						"type": "Expression"
					},
					"condition": {
						"value": "@and(\n  equals(item().type, 'File'),\n  greaterOrEquals(\n    split(item().name, '.')[1],\n    formatDateTime(addDays(utcnow(), mul(-1, pipeline().parameters.lookback_days)), 'yyyyMMdd')\n  )\n)",
						"type": "Expression"
