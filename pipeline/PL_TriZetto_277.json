							"name": "If 5L9M File Not Ingested",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "Check 5L9M File In Ledger",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@not(activity('Check 5L9M File In Ledger').output.exists)",
									"type": "Expression"
								},
								"ifTrueActivities": [
									{
										"name": "Copy 5L9M File",
										"type": "Copy",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 1,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [
											{
												"name": "file",
												"value": {
													"value": "@item().name",
													"type": "Expression"
												}
											}
										],
										"typeProperties": {
											"source": {
												"type": "BinarySource",
												"storeSettings": {
													"type": "SftpReadSettings",
													"recursive": false,
													"disableChunking": false
												},
												"formatSettings": {
													"type": "BinaryReadSettings"
												}
											},
											"sink": {
												"type": "BinarySink",
												"storeSettings": {
													"type": "AzureBlobStorageWriteSettings"
												}
											},
											"enableStaging": false
										},
										"inputs": [
											{
												"referenceName": "DS_TriZetto_5L9M_SFTP_Binary",
												"type": "DatasetReference",
												"parameters": {
													"remote_directory": {
														"value": "@variables('src_folder')",
														"type": "Expression"
													},
													"filename": {
														"value": "@item().name",
														"type": "Expression"
													}
												}
											}
										],
										"outputs": [
											{
												"referenceName": "DS_AzureBlob_Spire_Singlefile_Binary",
												"type": "DatasetReference",
												"parameters": {
													"auth_sas_url_sec": {
														"value": "@pipeline().globalParameters.ENV_KV_SPIRE_AZURE_BLOB_SAS_URL_SEC",
														"type": "Expression"
													},
													"container": {
														"value": "@variables('tgt_container')",
														"type": "Expression"
													},
													"path": {
														"value": "@concat(activity('Execute PL_Output_Paths').output.pipelineReturnValue.bin_output_path, '/5L9M')",
														"type": "Expression"
													},
													"file": {
														"value": "@item().name",
														"type": "Expression"
													}
												}
											}
										]
