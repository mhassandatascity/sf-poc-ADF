													"value": "@item().pbiDatasetName",
													"type": "Expression"
												},
												"pbiWorkspaceId": {
													"value": "@item().pbiWorkspaceId",
													"type": "Expression"
												},
												"pbiDatasetId": {
													"value": "@item().pbiDatasetId",
													"type": "Expression"
												},
												"pollingIntervalInSeconds": {
													"value": "@item().pollingIntervalInSeconds",
													"type": "Expression"
												}
											}
										}
									}
								]
							}
						}
					]
				}
			}
		],
		"parameters": {
			"pbiDatasetInputs": {
				"type": "Array"
			}
		},
		"folder": {
