				}
			}
		],
		"parameters": {
			"python_script_path": {
				"type": "string"
			},
			"command": {
				"type": "string"
			},
			"main_pipeline_name": {
				"type": "string"
			},
			"main_pipeline_run_id": {
				"type": "string"
			}
		},
		"folder": {
			"name": "Job_BatchPool"
		},
		"annotations": []
	}
