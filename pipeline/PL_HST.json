{
	"name": "PL_HST",
	"properties": {
		"description": "Loads HSTPathways daily _NNN-chunked files from S3 external stage @AWS_S3_HSTPATHWAYS into DEV_RAW.HSTPATHWAYSSTAGING tables. Source files are headerless CSV. Prereq: 171 target tables created via hsthighway/hst_table_column_names_all.sql (16 Visit-domain) + hsthighway/hst_table_column_names_rest.sql (155 others); stage and FF_HSTPATHWAYS_CSV file format (SKIP_HEADER=0) already provisioned in Snowflake. All columns are VARCHAR until HSTPathways confirms unload column order.",
		"activities": [
			{
				"name": "Set schema path",
				"description": "<database_name>.<schema_name>",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "set_schema_path",
					"value": {
						"value": "@concat(toUpper(pipeline().globalParameters.ENV_STAGE),'_RAW.HSTPATHWAYSSTAGING')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set stage path",
				"description": "fully-qualified stage path",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Set schema path",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "set_stage_path",
					"value": {
						"value": "@concat(variables('set_schema_path'),'.AWS_S3_HSTPATHWAYS')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set file format path",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Set schema path",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "set_file_format_path",
					"value": {
						"value": "@concat(variables('set_schema_path'),'.FF_HSTPATHWAYS_CSV')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set today date folder",
				"description": "yyyy/MM/dd folder under unload/fullload/",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "today_date_folder",
					"value": {
						"value": "@formatDateTime(utcNow(),'yyyy/MM/dd')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "ForEachTable",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Set stage path",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set file format path",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set today date folder",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@variables('hst_tables')",
						"type": "Expression"
					},
					"isSequential": false,
					"batchCount": 8,
					"activities": [
						{
							"name": "TruncateTable",
							"type": "Script",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "LS_Snowflake_Spire",
								"type": "LinkedServiceReference",
								"parameters": {
									"warehouse": {
										"value": "@concat(toUpper(pipeline().globalParameters.ENV_STAGE), '_ADF_INGESTION_WH')",
										"type": "Expression"
									},
									"database": {
										"value": "@concat(toUpper(pipeline().globalParameters.ENV_STAGE), '_RAW')",
										"type": "Expression"
									},
									"user_name": {
										"value": "@concat(toUpper(pipeline().globalParameters.ENV_STAGE), '_SVC_ADF')",
										"type": "Expression"
									},
									"role": {
										"value": "@concat(toUpper(pipeline().globalParameters.ENV_STAGE), '_SVC_INGESTION_ROLE')",
										"type": "Expression"
									},
									"account_name": "spireortho-aaas.privatelink"
								}
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "@concat('TRUNCATE TABLE ', variables('set_schema_path'), '.', toUpper(item()))",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						},
						{
							"name": "ExecuteSnowflakeCopy",
							"type": "Script",
							"dependsOn": [
								{
									"activity": "TruncateTable",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "7.00:00:00",
								"retry": 2,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "LS_Snowflake_Spire",
								"type": "LinkedServiceReference",
								"parameters": {
									"warehouse": {
										"value": "@concat(toUpper(pipeline().globalParameters.ENV_STAGE), '_ADF_INGESTION_WH')",
										"type": "Expression"
									},
									"database": {
										"value": "@concat(toUpper(pipeline().globalParameters.ENV_STAGE), '_RAW')",
										"type": "Expression"
									},
									"user_name": {
										"value": "@concat(toUpper(pipeline().globalParameters.ENV_STAGE), '_SVC_ADF')",
										"type": "Expression"
									},
									"role": {
										"value": "@concat(toUpper(pipeline().globalParameters.ENV_STAGE), '_SVC_INGESTION_ROLE')",
										"type": "Expression"
									},
									"account_name": "spireortho-aaas.privatelink"
								}
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "@concat(\n  'COPY INTO ', variables('set_schema_path'), '.', toUpper(item()),\n  ' FROM @', variables('set_stage_path'),\n  ' PATTERN=''unload/fullload/', variables('today_date_folder'), '/', item(), '_[0-9]{3}$''',\n  ' FILE_FORMAT=', variables('set_file_format_path'), ';'\n)",
											"type": "Expression"
										}
									}
								]
							}
						},
						{
							"name": "If Errors",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "ExecuteSnowflakeCopy",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@or(contains(string(activity('ExecuteSnowflakeCopy').output.resultSets[0].rows), '\\\"status\\\":\\\"FAILED\\\"'), contains(string(activity('ExecuteSnowflakeCopy').output.resultSets[0].rows), '\\\"errors_seen\\\":\\\"1\\\"'))",
									"type": "Expression"
								},
								"ifTrueActivities": [
									{
										"name": "Fail1",
										"type": "Fail",
										"dependsOn": [],
										"userProperties": [],
										"typeProperties": {
											"message": {
												"value": "@concat('HST Snowflake load failed - \n    File loaded: ', activity('ExecuteSnowflakeCopy').output.resultSets[0].rows[0]['file'], ',\n    Target table: ', variables('set_schema_path'), '.', toUpper(item()) ,'\n    Rows loaded: ', activity('ExecuteSnowflakeCopy').output.resultSets[0].rows[0]['rows_loaded'], ', \n    Errors seen: ', activity('ExecuteSnowflakeCopy').output.resultSets[0].rows[0]['errors_seen']\n)",
												"type": "Expression"
											},
											"errorCode": "SNOWFLAKE_LOAD_VALIDATION_FAILED"
										}
									}
								]
							}
						}
					]
				}
			}
		],
		"variables": {
			"set_schema_path": {
				"type": "String"
			},
			"set_stage_path": {
				"type": "String"
			},
			"set_file_format_path": {
