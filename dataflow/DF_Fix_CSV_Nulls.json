{
	"name": "DF_Fix_CSV_Nulls",
	"properties": {
		"folder": {
			"name": "Shared_Dataflows"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_AzureBlob_Spire_SingleFile_CSV",
						"type": "DatasetReference"
					},
					"name": "CSVSource"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_AzureBlob_Spire_SingleFile_CSV",
						"type": "DatasetReference"
					},
					"name": "CSVSink"
				}
			],
			"transformations": [],
			"scriptLines": [
				"parameters{",
				"     file_name as string",
				"}",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     multiLineRow: true) ~> CSVSource",
				"CSVSource sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:[($file_name)],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> CSVSink"
			]
		}
	}
}