{
	"name": "PL_Paycom_sql",
	"properties": {
		"activities": [
			{
				"name": "Execute PL_AzureBlob_Data_Fetch_XLSX_To_CSV",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "Execute PL_Output_Paths",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set config_container_folder",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_AzureBlob_Data_Fetch_XLSX_To_CSV",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"src_container": {
							"value": "@variables('src_container')",
							"type": "Expression"
						},
						"src_container_folder": {
							"value": "@variables('src_filedrop_folder')",
							"type": "Expression"
						},
						"tgt_container": {
							"value": "@variables('tgt_container')",
							"type": "Expression"
						},
						"excel_output_path": {
							"value": "@activity('Execute PL_Output_Paths').output.pipelineReturnValue.excel_output_path",
							"type": "Expression"
						},
						"data_output_path": {
							"value": "@activity('Execute PL_Output_Paths').output.pipelineReturnValue.data_output_path",
							"type": "Expression"
						},
						"main_pipeline_run_id": {
							"value": "@pipeline().RunId",
							"type": "Expression"
						},
						"main_pipeline_name": {
							"value": "@pipeline().Pipeline",
							"type": "Expression"
						},
						"config_table": {
							"value": "@variables('config_table')",
							"type": "Expression"
						},
						"config_database": {
							"value": "@variables('config_database')",
							"type": "Expression"
						},
						"table_load_group": {
							"value": "@variables('table_load_group')",
							"type": "Expression"
						},
						"config_table_schema": {
							"value": "@variables('config_table_schema')",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "Execute PL_Output_Paths",
				"type": "ExecutePipeline",
				"dependsOn": [],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_Output_Paths",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"main_pipeline_name": {
							"value": "@pipeline().Pipeline",
							"type": "Expression"
						},
						"tgt_db": {
							"value": "@variables('tgt_db')",
							"type": "Expression"
						},
						"tgt_schema": {
							"value": "@variables('tgt_schema')",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "Set config_container_folder",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "config_container_folder",
					"value": {
						"value": "@pipeline().Pipeline",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Check If Payroll Report Exists",
				"description": "Check to see if payroll_report_raw.csv was created at data_output_path",
				"type": "GetMetadata",
				"dependsOn": [
					{
						"activity": "If Folder exists then only copy the data",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_AzureBlob_Spire_SingleFile_CSV",
						"type": "DatasetReference",
						"parameters": {
							"auth_sas_url_sec": {
								"value": "@pipeline().globalParameters.ENV_KV_SPIRE_AZURE_BLOB_SAS_URL_SEC",
								"type": "Expression"
							},
							"path": {
								"value": "@activity('Execute PL_Output_Paths').output.pipelineReturnValue.data_output_path",
								"type": "Expression"
							},
							"file": "payroll_report_raw.csv",
							"container": {
								"value": "@variables('tgt_container')",
								"type": "Expression"
							}
						}
					},
					"fieldList": [
						"exists"
					],
					"storeSettings": {
						"type": "AzureBlobStorageReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "If Payroll Report Exists",
				"description": "If payroll_report_raw.csv exists, add the stored procedure call for processing the report",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Check If Payroll Report Exists",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@activity('Check If Payroll Report Exists').output.exists",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Append Payroll SP Call 1",
							"description": "",
							"type": "AppendVariable",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"variableName": "sp_to_execute",
								"value": {
									"value": "@json('{\n    \"sp_db\": \"PaycomStaging\",\n    \"sp_schema\": \"dbo\",\n    \"sp_name\": \"sp_PayrollReportCleanupColumnNames\",\n    \"dataset\": \"Payroll Report Data\",\n    \"step\": \"Refactoring Column Names And Mapping Them To Database Table Column Names\"\n}')",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Append Payroll SP Call 2",
							"description": "",
							"type": "AppendVariable",
							"dependsOn": [
								{
									"activity": "Append Payroll SP Call 1",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"variableName": "sp_to_execute",
								"value": {
									"value": "@json('{\n    \"sp_db\": \"PaycomStaging\",\n    \"sp_schema\": \"dbo\",\n    \"sp_name\": \"sp_PayrollReportCalcBaseMetrics\",\n    \"dataset\": \"Payroll Report Data\",\n    \"step\": \"Aggregating Values from Multiple Source Columns to Mapped Columns\"\n}')",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Append Payroll SP Call 3",
							"description": "",
							"type": "AppendVariable",
							"dependsOn": [
								{
									"activity": "Append Payroll SP Call 2",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"variableName": "sp_to_execute",
								"value": {
									"value": "@json('{\n    \"sp_db\": \"PaycomReplicated\",\n    \"sp_schema\": \"dbo\",\n    \"sp_name\": \"LOAD_PAYROLL_REPORT_DATA\",\n    \"dataset\": \"Payroll Report Data\",\n    \"step\": \"Loading The Aggregated Payroll Metrics To Replication Database For Reporting\"\n}')",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "For Each Stored Procedure To Execute",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Append Dimension SP",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@variables('sp_to_execute')",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "If SP Has Not Failed",
							"description": "Only execute stored procedure if there are no prior failures",
							"type": "IfCondition",
							"dependsOn": [],
							"userProperties": [
								{
									"name": "item",
									"value": "[@{item().sp_db}].[@{item().sp_schema}].[@{item().sp_name}]"
								}
							],
							"typeProperties": {
								"expression": {
									"value": "@not(variables('sp_has_failed'))",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "Append Data Processing Skipped",
										"type": "AppendVariable",
										"dependsOn": [],
										"userProperties": [],
										"typeProperties": {
											"variableName": "data_process_step_skipped",
											"value": {
												"value": "@concat(\n        '<span style=font-weight:bold>Dataset</span>: ',item().dataset,'<br/><span style=font-weight:bold>- Step</span>: ',item().step\n    )\n",
												"type": "Expression"
											}
										}
									}
								],
								"ifTrueActivities": [
									{
										"name": "Execute PL_Execute_Single_Stored_Procedure1",
										"type": "Wait",
										"dependsOn": [],
										"userProperties": [],
										"typeProperties": {
											"waitTimeInSeconds": 1
										}
									}
								]
							}
						},
						{
							"name": "Set sp_has_failed True",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "If SP Has Not Failed",
									"dependencyConditions": [
										"Failed",
										"Skipped"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [
								{
									"name": "item",
									"value": "[@{item().sp_db}].[@{item().sp_schema}].[@{item().sp_name}]"
								}
							],
							"typeProperties": {
								"variableName": "sp_has_failed",
								"value": {
									"value": "@bool(1)",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Append Data Process Failed sp",
							"type": "AppendVariable",
							"dependsOn": [
								{
									"activity": "Set sp_has_failed True",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"variableName": "data_process_step_failed",
								"value": {
									"value": "@concat(\n       '<span style=font-weight:bold>Dataset</span>: ',item().dataset,'<br/><span style=font-weight:bold> - Step</span>: ',item().step,'<br/><span style=font-weight:bold> - Error</span>: <span style=color:red;font-weight:bold>Execute PL_Execute_Single_Stored_Procedure - Errormessage Operation on target Execute Stored Procedure failed:</span>'\n    )",
									"type": "Expression"
								}
							}
						},
						{
							"name": "If Sp Succeeded Then Append Dataset",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "If SP Has Not Failed",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@and(not(variables('sp_has_failed')),contains(item().sp_name,'LOAD'))",
									"type": "Expression"
								},
								"ifTrueActivities": [
									{
										"name": "Append Data Process Success sp",
										"type": "AppendVariable",
										"dependsOn": [],
										"userProperties": [],
										"typeProperties": {
											"variableName": "data_process_step_succeeded",
											"value": {
												"value": "@concat(\n        '<span style=font-weight:bold>Dataset</span>: ',item().dataset,'<br/><span style=font-weight:bold> - Step</span>: ',item().step\n    )\n",
												"type": "Expression"
											}
										}
									}
								]
							}
						}
					]
				}
			},
			{
				"name": "Check If Budget Report Exists",
				"description": "Check to see if budget_report_raw.csv was created at data_output_path",
				"type": "GetMetadata",
				"dependsOn": [
					{
						"activity": "If Folder exists then only copy the data",
