					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_AzureBlob_Spire_SingleFile_CSV",
						"type": "DatasetReference",
						"parameters": {
							"auth_sas_url_sec": {
								"value": "@pipeline().globalParameters.ENV_KV_SPIRE_AZURE_BLOB_SAS_URL_SEC",
								"type": "Expression"
							},
							"path": {
								"value": "@activity('Execute PL_Output_Paths').output.pipelineReturnValue.data_output_path",
								"type": "Expression"
							},
							"file": "budget_report_raw.csv",
							"container": {
								"value": "@variables('tgt_container')",
								"type": "Expression"
							}
						}
					},
					"fieldList": [
						"exists"
					],
					"storeSettings": {
						"type": "AzureBlobStorageReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "If Budget Report Exists",
				"description": "If budget_report_raw.csv exists, add the stored procedure call for processing the report",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Check If Budget Report Exists",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@activity('Check If Budget Report Exists').output.exists",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Append Budget SP Call 1",
							"description": "",
							"type": "AppendVariable",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"variableName": "sp_to_execute",
								"value": {
									"value": "@json('{\n    \"sp_db\": \"PaycomStaging\",\n    \"sp_schema\": \"dbo\",\n    \"sp_name\": \"sp_BudgetReportPivot\",\n    \"dataset\": \"Budget Report\",\n    \"step\": \"Pivoting The Budget Report Data To Calculate The Expense\"\n}')",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Append Budget SP Call 2",
							"description": "",
							"type": "AppendVariable",
							"dependsOn": [
								{
									"activity": "Append Budget SP Call 1",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"variableName": "sp_to_execute",
								"value": {
									"value": "@json('{\n    \"sp_db\": \"PaycomReplicated\",\n    \"sp_schema\": \"dbo\",\n    \"sp_name\": \"LOAD_BUDGET_REPORT_DATA\",\n    \"dataset\": \"Budget Report\",\n    \"step\": \"Loading Budget Report Data From Staging Database To Replication Database For Reporting\"\n}')",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "Check If Bonus Budget Report Exists",
				"description": "Check to see if bonus_budget_report_raw.csv was created at data_output_path",
				"type": "GetMetadata",
				"dependsOn": [
					{
						"activity": "If Folder exists then only copy the data",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_AzureBlob_Spire_SingleFile_CSV",
						"type": "DatasetReference",
						"parameters": {
							"auth_sas_url_sec": {
								"value": "@pipeline().globalParameters.ENV_KV_SPIRE_AZURE_BLOB_SAS_URL_SEC",
								"type": "Expression"
							},
							"path": {
								"value": "@activity('Execute PL_Output_Paths').output.pipelineReturnValue.data_output_path",
								"type": "Expression"
							},
							"file": "bonus_budget_report_raw.csv",
							"container": {
								"value": "@variables('tgt_container')",
								"type": "Expression"
							}
						}
					},
					"fieldList": [
						"exists"
					],
					"storeSettings": {
						"type": "AzureBlobStorageReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "If Bonus Budget Report Exists",
				"description": "If bonus_budget_report_raw.csv exists, add the stored procedure call for processing the report",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Check If Bonus Budget Report Exists",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@activity('Check If Bonus Budget Report Exists').output.exists",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Append Bonus Budget SP Call 1",
							"description": "",
							"type": "AppendVariable",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"variableName": "sp_to_execute",
								"value": {
									"value": "@json('{\n    \"sp_db\": \"PaycomStaging\",\n    \"sp_schema\": \"dbo\",\n    \"sp_name\": \"sp_BonusBudgetReportPivot\",\n    \"dataset\": \"Bonus Budget Report\",\n    \"step\": \"Pivoting The Bonus Budget Report Data To Calculate The Expense\"\n}')",
									"type": "Expression"
								}
