			},
			{
				"name": "Append Dimension SP",
				"description": "If condition will always be true (this is just used for grouping the dimension stored procedures)",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "If Payroll Report Exists",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "If Budget Report Exists",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "If Bonus Budget Report Exists",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "If Department Mapped File Exists",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "If Location Mapped File Exists",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@not(empty(activity('Execute PL_AzureBlob_Data_Fetch_XLSX_To_CSV').output.pipelineReturnValue.files_mapped))",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
