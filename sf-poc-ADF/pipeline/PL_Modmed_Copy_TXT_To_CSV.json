{
	"name": "PL_Modmed_Copy_TXT_To_CSV",
	"properties": {
		"activities": [
			{
				"name": "Copy all TXT to CSV",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Get TXT File Names",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Get TXT File Names').output.childItems",
						"type": "Expression"
					},
					"isSequential": false,
					"batchCount": 10,
					"activities": [
						{
							"name": "Copy TXT to CSV",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [
								{
									"name": "item",
									"value": "@item().Name"
								}
							],
							"typeProperties": {
								"source": {
									"type": "DelimitedTextSource",
									"storeSettings": {
										"type": "AzureBlobStorageReadSettings",
										"recursive": true
									},
									"formatSettings": {
										"type": "DelimitedTextReadSettings"
									}
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobStorageWriteSettings"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".txt"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "DS_AzureBlob_Spire_SingleFile_TXT",
									"type": "DatasetReference",
									"parameters": {
										"auth_sas_url_sec": {
											"value": "@pipeline().globalParameters.ENV_KV_SPIRE_AZURE_BLOB_SAS_URL_SEC",
											"type": "Expression"
										},
										"path": {
											"value": "@pipeline().parameters.src_txt_files_path",
											"type": "Expression"
										},
										"file": {
											"value": "@item().Name",
											"type": "Expression"
										},
										"container": {
											"value": "@pipeline().parameters.tgt_container",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_AzureBlob_Spire_SingleFile_CSV",
									"type": "DatasetReference",
									"parameters": {
										"auth_sas_url_sec": {
											"value": "@pipeline().globalParameters.ENV_KV_SPIRE_AZURE_BLOB_SAS_URL_SEC",
											"type": "Expression"
										},
										"path": {
											"value": "@{pipeline().parameters.tgt_data_output_path}",
											"type": "Expression"
										},
										"file": {
											"value": "@replace(item().Name,'.txt','.csv')",
											"type": "Expression"
										},
										"container": {
											"value": "@pipeline().parameters.tgt_container",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			},
			{
				"name": "Get TXT File Names",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_AzureBlob_Spire_Multifile_Binary",
						"type": "DatasetReference",
						"parameters": {
							"auth_sas_url_sec": {
								"value": "@pipeline().globalParameters.ENV_KV_SPIRE_AZURE_BLOB_SAS_URL_SEC",
								"type": "Expression"
							},
							"container": {
								"value": "@pipeline().parameters.tgt_container",
								"type": "Expression"
							},
							"path": {
								"value": "@pipeline().parameters.src_txt_files_path",
								"type": "Expression"
							}
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobStorageReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "BinaryReadSettings"
					}
				}
			}
		],
		"parameters": {
			"tgt_data_output_path": {
				"type": "string"
			},
			"tgt_container": {
				"type": "string"
			},
			"src_txt_files_path": {
				"type": "string"
			},
			"table_load_group": {
				"type": "string"
			},
			"config_table_db": {
				"type": "string"
			},
			"config_table_schema": {
				"type": "string"
			},
			"config_table_name": {
				"type": "string"
			},
			"source_key": {
				"type": "string"
			},
			"main_pipeline_run_id": {
				"type": "string"
			},
			"main_pipeline_name": {
				"type": "string"
			}
		},
		"folder": {
			"name": "Job_Modmed"
		},
		"annotations": []
	}
}