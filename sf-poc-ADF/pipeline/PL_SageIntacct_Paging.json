					"url": "https://api.intacct.com/ia/xml/xmlgw.phtml/",
					"connectVia": {
						"referenceName": "SAE-SelfHosted-IR",
						"type": "IntegrationRuntimeReference"
					},
					"body": {
						"value": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<request>\n    <control>\n        <senderid>@{activity('Get Control SenderId').output.value}</senderid>\n        <password>@{activity('Get Control Password').output.value}</password>\n        <controlid>@{div(sub(ticks(utcNow()), ticks('1970-01-01')),10000000)}</controlid>\n        <uniqueid>false</uniqueid>\n        <dtdversion>3.0</dtdversion>\n        <includewhitespace>false</includewhitespace>\n    </control>\n    <operation>\n        <authentication>\n        \t<sessionid>@{pipeline().parameters.session_id}</sessionid>\n        </authentication>\n        <content>\n            <function controlid=\"@{guid()}\">\n                <query>\n                    <select>\n                        @{activity('Get XML Fields').output.firstRow['xml_columns']}\n                    </select>\n                    <object>@{pipeline().parameters.table_name}</object>\n                    @{variables('filter_condition')}\n                    <pagesize>10</pagesize>\n                    <offset>\n                        @{variables('offset')}\n                    </offset>\n                </query>\n            </function>\n        </content>\n    </operation>\n</request>",
						"type": "Expression"
					}
				}
			},
