		"activities": [
			{
				"name": "Get Data File Names",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_AzureBlob_Spire_SingleFile_CSV",
						"type": "DatasetReference",
						"parameters": {
							"auth_sas_url_sec": {
								"value": "@pipeline().globalParameters.ENV_KV_SPIRE_AZURE_BLOB_SAS_URL_SEC",
								"type": "Expression"
							},
							"path": {
								"value": "@pipeline().parameters.src_data_path",
								"type": "Expression"
							},
							"file": "*.csv",
							"container": {
								"value": "@pipeline().parameters.src_data_container",
								"type": "Expression"
