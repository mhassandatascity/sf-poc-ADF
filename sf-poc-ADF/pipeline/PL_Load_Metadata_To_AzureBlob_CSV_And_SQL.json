								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [
								{
									"name": "item",
									"value": "@{item().name}"
								}
							],
							"typeProperties": {
								"dataset": {
									"referenceName": "DS_AzureBlob_Spire_SingleFile_CSV",
									"type": "DatasetReference",
									"parameters": {
										"auth_sas_url_sec": {
											"value": "@pipeline().globalParameters.ENV_KV_SPIRE_AZURE_BLOB_SAS_URL_SEC",
											"type": "Expression"
										},
										"path": {
											"value": "@pipeline().parameters.src_data_path",
											"type": "Expression"
										},
										"file": {
											"value": "@item().name",
											"type": "Expression"
										},
										"container": {
											"value": "@pipeline().parameters.src_data_container",
											"type": "Expression"
										}
									}
								},
								"fieldList": [
									"columnCount",
									"structure"
