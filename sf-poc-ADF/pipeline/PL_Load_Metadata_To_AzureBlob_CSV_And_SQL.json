								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [
								{
									"name": "item",
									"value": "@{item().name}"
								}
							],
							"typeProperties": {
								"source": {
									"type": "JsonSource",
									"additionalColumns": [
										{
											"name": "TableName",
											"value": {
												"value": "@replace(item().name,'.json','')",
												"type": "Expression"
											}
										},
										{
											"name": "DBName",
											"value": {
												"value": "@pipeline().parameters.tgt_db",
												"type": "Expression"
