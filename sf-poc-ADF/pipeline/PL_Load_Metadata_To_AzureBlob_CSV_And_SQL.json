										},
										{
											"name": "TableSchema",
											"value": {
												"value": "@pipeline().parameters.tgt_tables_schema",
												"type": "Expression"
											}
										},
										{
											"name": "BlobFilePath",
											"value": {
												"value": "@{pipeline().parameters.src_data_container}/@{pipeline().parameters.src_data_path}/@{item().name}",
												"type": "Expression"
											}
										}
									],
									"storeSettings": {
										"type": "AzureBlobStorageReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "DelimitedTextReadSettings"
									}
								},
								"sink": {
									"type": "DelimitedTextSink",
