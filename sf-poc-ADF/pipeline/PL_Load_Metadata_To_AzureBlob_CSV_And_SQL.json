									"type": "TabularTranslator",
									"mappings": [
										{
											"source": {
												"name": "DBName",
												"type": "String"
											},
											"sink": {
												"name": "DBName",
												"physicalType": "String"
											}
										},
										{
											"source": {
												"name": "TableSchema",
												"type": "String"
											},
											"sink": {
												"name": "TableSchema",
												"physicalType": "String"
											}
										},
										{
											"source": {
												"name": "TableName",
												"type": "String"
											},
											"sink": {
												"name": "TableName",
												"physicalType": "String"
											}
										},
										{
											"source": {
												"name": "BlobFilePath",
												"type": "String"
											},
											"sink": {
												"name": "BlobFilePath",
												"physicalType": "String"
											}
										},
										{
											"source": {
												"name": "ColumnCount",
												"type": "String"
											},
											"sink": {
												"name": "ColumnCount",
												"physicalType": "String"
											}
										}
