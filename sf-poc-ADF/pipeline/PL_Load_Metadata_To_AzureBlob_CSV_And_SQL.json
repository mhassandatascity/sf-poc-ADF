										"type": "AzureBlobStorageWriteSettings"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".txt"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"mappings": [
										{
											"source": {
												"path": "$['DBName']"
											},
											"sink": {
												"name": "DBName",
												"type": "String"
											}
										},
										{
											"source": {
												"path": "$['TableSchema']"
											},
											"sink": {
												"name": "TableSchema",
												"type": "String"
											}
										},
										{
											"source": {
												"path": "$['TableName']"
											},
											"sink": {
												"name": "TableName",
												"type": "String"
											}
										},
										{
											"source": {
												"path": "$['BlobFilePath']"
											},
											"sink": {
												"name": "BlobFilePath",
												"type": "String"
											}
										},
										{
											"source": {
												"path": "$['name']"
											},
											"sink": {
												"name": "ColumnName",
												"type": "String"
											}
										}
									]
								}
							},
							"inputs": [
								{
									"referenceName": "DS_AzureBlob_Spire_SingleFile_JSON",
									"type": "DatasetReference",
									"parameters": {
										"auth_sas_url_sec": {
											"value": "@pipeline().globalParameters.ENV_KV_SPIRE_AZURE_BLOB_SAS_URL_SEC",
											"type": "Expression"
										},
										"container": {
											"value": "@pipeline().parameters.tgt_metadata_container",
											"type": "Expression"
										},
										"path": {
											"value": "@{pipeline().parameters.tgt_metadata_path}/TableColumnSchema",
											"type": "Expression"
										},
										"file": {
											"value": "@item().name",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_AzureBlob_Spire_SingleFile_CSV",
									"type": "DatasetReference",
									"parameters": {
										"auth_sas_url_sec": {
											"value": "@pipeline().globalParameters.ENV_KV_SPIRE_AZURE_BLOB_SAS_URL_SEC",
											"type": "Expression"
										},
										"path": {
											"value": "@{pipeline().parameters.tgt_metadata_path}/TableColumnSchema",
											"type": "Expression"
										},
										"file": {
											"value": "@replace(item().name,'.json','.csv')",
											"type": "Expression"
										},
										"container": {
											"value": "@pipeline().parameters.tgt_metadata_container",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			},
			{
				"name": "Execute PL_Combine_And_Update_Metadata",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "For Each Schema JSON Convert to CSV",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_Combine_And_Update_Metadata",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"tgt_container": {
							"value": "@pipeline().parameters.src_data_container",
							"type": "Expression"
						},
						"tgt_metadata_output_path": {
							"value": "@pipeline().parameters.tgt_metadata_path",
							"type": "Expression"
						},
						"tgt_db": {
							"value": "@pipeline().parameters.tgt_db",
							"type": "Expression"
						},
						"tgt_schema": {
							"value": "@pipeline().parameters.tgt_tables_schema",
							"type": "Expression"
						},
						"tgt_metadata_schema": {
							"value": "@pipeline().parameters.tgt_metadata_schema",
							"type": "Expression"
						},
						"row_count_tables": {
							"value": "@createArray('TableColumnCounts','TableColumnSchema')",
							"type": "Expression"
						}
					}
				}
			}
		],
		"parameters": {
			"src_data_container": {
				"type": "string"
			},
			"src_data_path": {
				"type": "string"
			},
			"tgt_metadata_container": {
				"type": "string"
			},
			"tgt_metadata_path": {
				"type": "string"
			},
			"tgt_db": {
				"type": "string"
			},
			"tgt_tables_schema": {
				"type": "string"
			},
			"tgt_metadata_schema": {
				"type": "string",
				"defaultValue": "metadata"
			},
			"main_pipeline_name": {
				"type": "string"
			},
			"main_pipeline_run_id": {
				"type": "string"
			}
		},
		"folder": {
			"name": "Shared_Pipelines"
		},
		"annotations": []
	}
}