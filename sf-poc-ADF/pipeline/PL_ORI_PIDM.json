{
	"name": "PL_ORI_PIDM",
	"properties": {
		"activities": [
			{
				"name": "Get Table List",
				"type": "ExecutePipeline",
				"dependsOn": [],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_Fetch_Source_Table_Configs",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"table": {
							"value": "@variables('config_table_name')",
							"type": "Expression"
						},
						"database": {
							"value": "@concat(toUpper(pipeline().globalParameters.ENV_STAGE), '_META')",
							"type": "Expression"
						},
						"table_schema": {
							"value": "@variables('config_table_schema')",
							"type": "Expression"
						},
						"addl_tbl_filter": "\"Database\"='PIDM_ori'"
					}
				}
			},
			{
				"name": "Execute PL_Output_Paths",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "Get Table List",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_Output_Paths",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"main_pipeline_name": {
							"value": "@pipeline().Pipeline",
							"type": "Expression"
						},
						"tgt_db": {
							"value": "@variables('tgt_db')",
							"type": "Expression"
						},
						"tgt_schema": {
							"value": "@variables('tgt_schema')",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "Set config_container_folder",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Get Table List",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "config_file_folder",
					"value": {
						"value": "@pipeline().Pipeline",
						"type": "Expression"
					}
				}
			},
			{
				"name": "PL_DBT_LOG_FILE_FOLDER_SF",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "Execute PL_Output_Paths",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_DBT_LOG_FILE_FOLDER_SF",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"PipelineName": {
							"value": "@pipeline().Pipeline",
							"type": "Expression"
						},
						"FolderDate": {
							"value": "@activity('Execute PL_Output_Paths').output.pipelineReturnValue.data_folder_path",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "ForEachTable",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Execute PL_Output_Paths",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set config_container_folder",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Get Table List').output.pipelineReturnValue.TableNames",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "current_table",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "current_table",
								"value": {
									"value": "@concat(\n  'Path: ',\n  activity('Execute PL_Output_Paths').output,\n  ', File: ',\n  item().Table,\n  '.csv'\n)\n",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Copy data1",
							"type": "Copy",
							"dependsOn": [
								{
									"activity": "current_table",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [
								{
									"name": "table_name",
									"value": "@{item().Table}"
								}
							],
							"typeProperties": {
								"source": {
									"type": "SqlServerSource",
									"sqlReaderQuery": {
										"value": "@concat('SELECT * FROM dbo.[', item().Table, ']')\n",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobStorageWriteSettings"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".txt"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "DS_SqlServer_ORI_PIDM",
									"type": "DatasetReference",
									"parameters": {
										"schema": "*",
										"table": "*"
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_AzureBlob_Spire_SingleFile_CSV",
									"type": "DatasetReference",
									"parameters": {
										"auth_sas_url_sec": "@pipeline().globalParameters.ENV_KV_SPIRE_AZURE_BLOB_SAS_URL_SEC",
										"path": {
											"value": "@activity('Execute PL_Output_Paths').output.pipelineReturnValue.data_output_path",
											"type": "Expression"
										},
										"file": {
											"value": "@{item().Table}.csv",
											"type": "Expression"
										},
										"container": {
											"value": "@variables('tgt_container')",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			},
			{
				"name": "DBT Ingest ORI-PIDM",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "ForEachTable",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_DBT_Run_Command_Ingest",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"model_path": "path:models/Bronze/RAW/ORI_PIDM_Replicated"
					}
				}
			},
			{
				"name": "DBT Test ORI-PIDM",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "DBT Ingest ORI-PIDM",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_DBT_Run_Command_Ingest",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"model_path": "path:models/Bronze/RAW/ORI_PIDM_Replicated"
					}
				}
			}
		],
		"policy": {
			"elapsedTimeMetric": {
				"duration": "00.01:40:00"
			}
		},
		"variables": {
			"restore_sp_db": {
				"type": "String",
				"defaultValue": "etl_metadata"
			},
			"restore_sp_schema": {
				"type": "String",
				"defaultValue": "dbo"
			},
			"create_user_sp_schema": {
				"type": "String",
				"defaultValue": "dbo"
			},
			"restore_sp": {
				"type": "String",
				"defaultValue": "PIDM_ori_Gen_RestoreDatabase"
			},
			"create_users_sp": {
				"type": "String",
				"defaultValue": "PIDM_ori_Database_addUsers"
			},
			"config_database": {
				"type": "String",
				"defaultValue": "DEV_META"
			},
			"config_table_schema": {
				"type": "String",
				"defaultValue": "ETL_METADATA"
			},
			"config_table_name": {
				"type": "String",
				"defaultValue": "ADF_ORI_SOURCE_TABLE_CONFIGS"
			},
			"tgt_db": {
				"type": "String",
				"defaultValue": "OrthoRhodeIslandReplicated"
			},
			"tgt_schema": {
				"type": "String",
				"defaultValue": "dbo"
			},
			"config_file_folder": {
				"type": "String"
			},
			"tgt_container": {
				"type": "String",
				"defaultValue": "ortho-rhode-island"
			},
			"current_table": {
				"type": "String"
			}
		},
		"folder": {
			"name": "Job_ORI"
		},
		"annotations": []
	}
}