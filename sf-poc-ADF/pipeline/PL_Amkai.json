{
	"name": "PL_Amkai",
	"properties": {
		"activities": [
			{
				"name": "Execute PL_Output_Paths",
				"type": "ExecutePipeline",
				"dependsOn": [],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_Output_Paths",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"main_pipeline_name": {
							"value": "@pipeline().Pipeline",
							"type": "Expression"
						},
						"tgt_db": {
							"value": "@variables('tgt_db')",
							"type": "Expression"
						},
						"tgt_schema": {
							"value": "@variables('tgt_schema')",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "Set config_container_folder",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "config_file_folder",
					"value": {
						"value": "@pipeline().Pipeline",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Execute PL_Amkai_Data_Fetch",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "Execute PL_Output_Paths",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set config_container_folder",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_Amkai_Data_Fetch",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"config_file_folder": {
							"value": "@variables('config_file_folder')",
							"type": "Expression"
						},
						"config_container": {
							"value": "@variables('config_container')",
							"type": "Expression"
						},
						"sql_file_folder": {
							"value": "@variables('sql_file_folder')",
							"type": "Expression"
						},
						"tgt_db": {
							"value": "@variables('tgt_db')",
							"type": "Expression"
						},
						"tgt_container": {
							"value": "@variables('tgt_container')",
							"type": "Expression"
						},
						"tgt_data_output_path": {
							"value": "@activity('Execute PL_Output_Paths').output.pipelineReturnValue.data_output_path",
							"type": "Expression"
						},
						"main_pipeline_name": {
							"value": "@pipeline().Pipeline",
							"type": "Expression"
						},
						"main_pipeline_run_id": {
							"value": "@pipeline().RunId",
							"type": "Expression"
						},
						"source_key": {
							"value": "@variables('source_key')",
							"type": "Expression"
						},
						"config_table": {
							"value": "@variables('config_table')",
							"type": "Expression"
						},
						"config_database": {
							"value": "@concat(toUpper(pipeline().globalParameters.ENV_STAGE), '_META')",
							"type": "Expression"
						},
						"config_table_schema": {
							"value": "@variables('config_table_schema')",
							"type": "Expression"
						},
						"table_load_group": {
							"value": "@pipeline().parameters.table_load_group",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "PL_DBT_LOG_FILE_FOLDER_SF",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "Execute PL_Output_Paths",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_DBT_LOG_FILE_FOLDER_SF",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"PipelineName": {
							"value": "@pipeline().Pipeline",
							"type": "Expression"
						},
						"FolderDate": {
							"value": "@activity('Execute PL_Output_Paths').output.pipelineReturnValue.data_folder_path",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "DBT Ingest Amkai",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "Execute PL_Amkai_Data_Fetch",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_DBT_Run_Command_Ingest",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"model_path": "path:models/Bronze/RAW/AmkaiStaging"
					}
				}
			},
			{
				"name": "DBT Test Amkai",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "DBT Ingest Amkai",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_DBT_Run_Command_Ingest",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"model_path": "path:models/Bronze/RAW/AmkaiStaging",
						"dbt_command": "test"
					}
				}
			}
		],
		"policy": {
			"elapsedTimeMetric": {
				"duration": "00.01:45:00"
			}
		},
		"parameters": {
			"table_load_group": {
				"type": "string"
			}
		},
		"variables": {
			"tgt_db": {
				"type": "String",
				"defaultValue": "AmkaiStaging"
			},
			"tgt_schema": {
				"type": "String",
				"defaultValue": "dbo"
			},
			"tgt_container": {
				"type": "String",
				"defaultValue": "amkai"
			},
			"config_container": {
				"type": "String",
				"defaultValue": "utility"
			},
			"config_file_name": {
				"type": "String",
				"defaultValue": "file_configs.json"
			},
			"sql_file_folder": {
				"type": "String",
				"defaultValue": "snowflake_files"
			},
			"config_file_folder": {
				"type": "String"
			},
			"source_key": {
				"type": "String",
				"defaultValue": "2"
			},
			"config_database": {
				"type": "String",
				"defaultValue": "DEV_META"
			},
			"config_table_schema": {
				"type": "String",
				"defaultValue": "etl_metadata"
			},
			"config_table": {
				"type": "String",
				"defaultValue": "adf_amkai_source_table_configs"
			}
		},
		"folder": {
			"name": "Job_Amkai"
		},
		"annotations": []
	}
}