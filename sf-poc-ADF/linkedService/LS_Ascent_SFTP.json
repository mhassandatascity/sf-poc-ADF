{
	"name": "LS_Ascent_SFTP",
	"properties": {
		"parameters": {
			"sftp_host": {
				"type": "string"
			},
			"sftp_port": {
				"type": "string",
				"defaultValue": "22"
			},
			"sftp_user_name": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "Sftp",
		"typeProperties": {
			"host": "@{linkedService().sftp_host}",
			"port": "@linkedService().sftp_port",
			"skipHostKeyValidation": true,
			"authenticationType": "Basic",
			"userName": "@{linkedService().sftp_user_name}",
			"password": {
				"type": "AzureKeyVaultSecret",
				"store": {
					"referenceName": "LS_SpireDF_KeyVault",
					"type": "LinkedServiceReference"
				},
				"secretName": {
					"value": "sec-ascent-sftp-password",
					"type": "Expression"
				}
			}
		},
		"connectVia": {
			"referenceName": "SAE-SelfHosted-IR",
			"type": "IntegrationRuntimeReference"
		}
	}
}